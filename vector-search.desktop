[Desktop Entry]
Version=1.0
Type=Application
Name=Vector Studio
GenericName=HNSW Vector Database & Search Engine
Comment=Zero-Dependency HNSW & IVF Vector Database, BM25 Hybrid Search, MMR Diversity & Clustering
Exec=/usr/local/bin/vector-search desktop
Icon=/media/neo/f2fdda77-178b-4603-ae80-c7aa4cd97908/zoth-micro-repos/vector-search-engine/assets/icon.png
Terminal=false
Categories=Development;Database;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open Vector CLI
Exec=x-terminal-emulator -e "/usr/local/bin/vector-search --help"

[Desktop Action Web]
Name=Open Web UI (Port 8093)
Exec=/usr/local/bin/vector-search web
